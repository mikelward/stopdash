<?xml version="1.0" encoding="utf-8"?>
<!-- Strings the phone app, its widget and the watch share (HeaderWords): the en-US base. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">
    <!-- A stop header's platform, %1$s its number as TfL gives it: "King's Cross St. Pancras – Platform 1". -->
    <string name="header_platform">Platform %1$s</string>
    <!-- [header_platform] cut short where a ride's stop heading needs the room: "Plat 6". -->
    <string name="header_platform_short">Plat %1$s</string>
    <!-- A bus stop's pole, %1$s the letter on its flag: "Turnpike Lane – Stop E". -->
    <string name="header_stop">Stop %1$s</string>
    <!-- Where a pole's buses go, as a screen reader hears it after the pole ("Stop G, towards Farringdon"),
         %1$s the place on its sign. Lowercase: it follows a comma. -->
    <string name="header_towards">towards %1$s</string>
    <!-- A bus pole with no letter, headed by the way it faces: its compass bearing as a direction word. -->
    <string name="header_bearing_n">Northbound</string>
    <string name="header_bearing_e">Eastbound</string>
    <string name="header_bearing_s">Southbound</string>
    <string name="header_bearing_w">Westbound</string>
    <string name="header_bearing_ne">Northeast-bound</string>
    <string name="header_bearing_nw">Northwest-bound</string>
    <string name="header_bearing_se">Southeast-bound</string>
    <string name="header_bearing_sw">Southwest-bound</string>
</resources>
