<?xml version="1.0" encoding="utf-8"?>
<!-- Strings the phone app, its widget and the watch share (HeaderWords): the en-US base. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">
    <!-- TODO: translate -->
    <!-- A stop header's platform, %1$s its number as TfL gives it: "King's Cross St. Pancras – Platform 1". -->
    <string name="header_platform" tools:ignore="MissingTranslation">Platform %1$s</string>
    <!-- TODO: translate -->
    <!-- [header_platform] cut short where a ride's stop heading needs the room: "Plat 6". -->
    <string name="header_platform_short" tools:ignore="MissingTranslation">Plat %1$s</string>
    <!-- TODO: translate -->
    <!-- A bus stop's pole, %1$s the letter on its flag: "Turnpike Lane – Stop E". -->
    <string name="header_stop" tools:ignore="MissingTranslation">Stop %1$s</string>
    <!-- TODO: translate -->
    <!-- Where a pole's buses go, as a screen reader hears it after the pole ("Stop G, towards Farringdon"),
         %1$s the place on its sign. Lowercase: it follows a comma. -->
    <string name="header_towards" tools:ignore="MissingTranslation">towards %1$s</string>
    <!-- TODO: translate -->
