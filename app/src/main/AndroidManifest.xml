<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Precise location for the nearby-stops search: a coarse fix put the nearest stop up to
         ~1 km off (a stop half a mile away read as nearest), so stopdash requests FINE and uses
         it when granted (maintainer, 2026-09-19). COARSE stays declared so the runtime dialog
         offers the precise/approximate choice and an approximate grant still finds stops,
         degraded. Location is sent to TfL to find stops: on demand in the app, and on a widget
         refresh only with "Widget follows you" on and this background grant held (SPEC D1 / Privacy);
         a trip on the way also checks it on the device just after boarding, never sending it
         (SPEC On the way). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Location allowed all the time, for two background uses: journey alerts fire only in London
         (SPEC *Journeys → Alerts*), compared on the phone and never sent; and the widget follows the
         rider (SPEC D1), whose stop lookup sends the position to TfL as the app's own does. Asked for
         from the favorite journeys list, a journey's Alerts screen and Settings' "Widget follows you". -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- "Get off soon" on a trip on the way (SPEC On the way): asked for when the rider taps
         Start, the one time an alert is wanted; a denial leaves the trip running, its screen saying
         alerts are off. VIBRATE, granted at install, lets the alert be felt in a pocket. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Following a trip on the way with the app closed (SPEC On the way): a foreground service,
         special use (live progress of a trip the user started, until they arrive or end it). Needs
         the Play Console foreground-service declaration before it ships. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Keeps the CPU awake while a trip is followed with the screen off (normal, granted at install). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- With location allowed, the same service takes a fix in the minute after the rider's train
         leaves the boarding stop, to see a rider left behind (SPEC On the way). Needs the Play
         Console location declaration before it ships. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- StopDash shows no ads: strip the advertising-ID and ad-attribution permissions the Firebase
         Analytics dependency would otherwise merge in. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <application
        android:name=".StopdashApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="${launcherIcon}"
        android:label="${appLabel}"
        android:roundIcon="${launcherIcon}"
        android:supportsRtl="true"
        android:theme="@style/Theme.StopDash">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.StopDash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The home-screen (and, where the OS allows, lock-screen) widget. Glance's receiver
             handles the APPWIDGET_UPDATE plumbing; the provider meta-data points at the sizing
             and category config. exported=true because the launcher/host binds it. -->
        <receiver
            android:name=".widget.StopDashWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stopdash_widget_info" />
        </receiver>

        <!-- Hears a journey alert swiped away (its delete intent, sent by this app's own
             PendingIntent), so the same disruption isn't posted again. Not exported. -->
        <receiver
            android:name=".JourneyAlertDismissReceiver"
            android:exported="false" />

        <!-- The inexact alarm that starts each journey alert check on time. -->
        <receiver
            android:name=".JourneyAlertAlarmReceiver"
            android:exported="false" />

        <!-- A clock set or a time-zone change re-schedules the journey alert check, whose windows
             are times of day where the rider is. System broadcasts, so a receiver that isn't
             exported hears them. -->
        <receiver
            android:name=".JourneyAlertClockReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- A setting of the device's clock redraws the widget, whose countdowns and age are
             drawn against the clock as it read then. A system broadcast, so it reaches a
             receiver that isn't exported. -->
        <receiver
            android:name=".widget.WidgetClockChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- Serves the bug-report screenshot to the app the user picks in the share sheet.
             Not exported: only the chooser target we grant a read to (per-Uri, per-share) can
             read it; nothing else, and never the rest of the cache (see @xml/file_paths). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Telemetry never starts on its own: collection stays off until StopdashApp applies the
             persisted "Help make StopDash better" choice, and both SDKs then remember the applied
             value across process starts. Inert in builds without a Firebase config
             (dev-docs/firebase.md). -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <!-- One activity draws every screen, so the app counts each itself (UsageEvent.ScreenView);
             Analytics' own would name only the activity. -->
        <meta-data
            android:name="google_analytics_automatic_screen_reporting_enabled"
            android:value="false" />

        <!-- Republishes the widget's snapshot when a watch gains the app or comes back in reach
             (dev-docs/wear-os.md). -->
        <service
            android:name=".OnTheWayService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the live progress of a public-transport trip the user started, and alerts them before their stop, until they arrive or end the trip." />
        </service>
        <service
            android:name=".watch.PhoneWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/stopdash_watch"
                    android:scheme="wear" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/stopdash/refresh"
                    android:scheme="wear" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/stopdash/complication-rows"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>

</manifest>
