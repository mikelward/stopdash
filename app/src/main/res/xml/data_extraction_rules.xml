<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup and device-to-device transfer (API 31+): as backup_rules.xml — everything but
     the telemetry opt-in and the Firebase SDKs' collection flags, so consent never carries over
     to another install, the per-watch complication rows, relearned from the watches still
     paired, the stops the app last found near the rider (where they are now), and the journey
     alerts' state, which describes this install's notifications and permission prompt, and the app version that
     last handed the widget picker its example, which belongs to this install's system. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="telemetry.xml" />
        <exclude domain="sharedpref" path="com.google.firebase.crashlytics.xml" />
        <exclude domain="sharedpref" path="com.google.android.gms.measurement.prefs.xml" />
        <exclude domain="sharedpref" path="watch_complication_rows.xml" />
        <exclude domain="file" path="datastore/widget-nearby-set.json" />
        <exclude domain="sharedpref" path="journey-alerts-state.xml" />
        <exclude domain="sharedpref" path="journey-alerts-announced.xml" />
        <exclude domain="sharedpref" path="journey-alerts-dismissed.xml" />
        <exclude domain="sharedpref" path="widget_preview.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="telemetry.xml" />
        <exclude domain="sharedpref" path="com.google.firebase.crashlytics.xml" />
        <exclude domain="sharedpref" path="com.google.android.gms.measurement.prefs.xml" />
        <exclude domain="sharedpref" path="watch_complication_rows.xml" />
        <exclude domain="file" path="datastore/widget-nearby-set.json" />
        <exclude domain="sharedpref" path="journey-alerts-state.xml" />
        <exclude domain="sharedpref" path="journey-alerts-announced.xml" />
        <exclude domain="sharedpref" path="journey-alerts-dismissed.xml" />
        <exclude domain="sharedpref" path="widget_preview.xml" />
    </device-transfer>
</data-extraction-rules>
