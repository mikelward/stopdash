<?xml version="1.0" encoding="utf-8"?>
<!-- Android backup (API 30 and below). Everything is backed up (SPEC Privacy) except the crash
     report / usage stats opt-in and the Firebase SDKs' own collection flags: consent is per
     install, so a restored install starts off and asks again (docs/PRIVACY.md). Nor the rows each
     paired watch's complications show: kept per watch, they're relearned from the watches still
     paired, and a restored copy would keep a gone watch's picks forever. Nor the stops the app
     last found near the rider, which the widget shows from: where they are now, and wrong on
     another phone. Nor the journey alerts' state: which alerts this install has shown or had
     swiped, and whether Android has stopped offering its notification prompt, are facts about this
     install, and a restored "prompt gone" would send Allow to Settings on a fresh one that can ask. -->
<full-backup-content>
    <exclude domain="sharedpref" path="telemetry.xml" />
    <exclude domain="sharedpref" path="com.google.firebase.crashlytics.xml" />
    <exclude domain="sharedpref" path="com.google.android.gms.measurement.prefs.xml" />
    <exclude domain="sharedpref" path="watch_complication_rows.xml" />
    <exclude domain="file" path="datastore/widget-nearby-set.json" />
    <exclude domain="sharedpref" path="journey-alerts-state.xml" />
    <exclude domain="sharedpref" path="journey-alerts-announced.xml" />
    <exclude domain="sharedpref" path="journey-alerts-dismissed.xml" />
</full-backup-content>
