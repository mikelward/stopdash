    <string name="settings_api_key_label">API key</string>
    <string name="settings_rail_key_title">National Rail API key</string>
    <string name="settings_rail_key_summary">Optional. Paste your free Rail Data Marketplace key to show National Rail times.</string>
    <string name="settings_api_key_save">Save</string>
    <string name="settings_api_key_clear">Clear</string>
    <string name="settings_api_key_show">Show</string>
    <string name="settings_api_key_hide">Hide</string>

