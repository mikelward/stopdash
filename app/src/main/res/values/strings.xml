<?xml version="1.0" encoding="utf-8"?>
<!-- The en-US base (tools:locale): en-GB overrides only what differs, in values-en-rGB. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">
    <string name="app_name">StopDash</string>

    <string name="stale_stamp">Tap to refresh</string>
    <!-- Pending stamp shown before the first snapshot is available (cold start, while the
         persisted snapshot is read off disk), so the placeholder frame carries a stamp
         rather than appearing without one (SPEC snapshot-render). -->
    <string name="loading_stamp">Loading…</string>

    <!-- Departures list -->
    <string name="departures_loading">Loading departures…</string>
    <string name="departures_empty">No upcoming departures</string>
    <!-- Under the starred-journey cards, when the nearby stops have nothing. -->
    <string name="departures_empty_nearby">No departures nearby</string>
    <!-- Empty list from a stale snapshot: don't assert "none" from data too old to
         trust — say it may be out of date and prompt a refresh (SPEC D4). -->
    <string name="departures_stale_empty">Departures may be out of date</string>
    <string name="refresh">Refresh</string>
    <!-- The app bar's crosshairs: re-locate, or back to the near-me list from a From… station. -->
    <string name="locate_here">Use my location</string>
    <!-- Star (pin-to-top) on a departure card, toggled by a long-press on the card; a pinned
         card is marked by a gold border, not an in-row element. `star` / `unstar` are the
         long-press action labels, so they flip with the state (a screen reader hears what the
         long-press does). -->
    <string name="star">Pin to top</string>
    <string name="unstar">Unpin from top</string>
    <!-- Transient snackbar when saving a pin/unpin fails (storage full, an IO error), so a
         tap that didn't take isn't silent. -->
    <string name="star_write_failed">Couldn\'t save your pin</string>
    <!-- Transient snackbar when dismissing a stop-closure alert fails to persist (storage full, an
         IO error), so a tap that didn't take isn't silent (mirrors star_write_failed). -->
    <string name="dismiss_write_failed">Couldn\'t dismiss alert</string>
    <!-- Route detail screen, opened by a tap on a departure/route card (a long-press still pins).
         `departure_details` is the card's tap action label a screen reader announces. The screen's
         app bar names the route (line pill + destination) and carries the star; the body names the
         boarding stop and the line's full disruption text. -->
    <string name="departure_details">Show details</string>
    <!-- Boarding-stop line in the route detail body. %1$s is the stop/interchange name; the app
         bar already shows where the service is going, so this names where it departs from. -->
    <string name="route_detail_from">From %1$s</string>
    <!-- The service's full name atop the route detail, for a tube or Overground line TfL names
         bare. %1$s is the line's name, e.g. "Victoria" → "Victoria line". -->
    <string name="route_detail_line_name">%1$s line</string>
    <!-- Spoken on the boarding stop of the route page's stop list, which is marked by a blue dot. -->
    <string name="route_stop_current">Your stop</string>
    <string name="route_detail_no_disruption">No disruptions reported</string>
    <string name="route_detail_alert_dismissed">Service alert dismissed</string>
    <!-- Shown in the route detail when its snapshot is stale: the disruption status is from old
         data, so the detail (which carries no freshness stamp of its own) says so rather than
         present stale status as current (SPEC D4). Not a "no disruptions" claim. -->
    <string name="route_detail_status_stale">Status may be out of date</string>
    <string name="route_stops_loading">Loading stops…</string>
    <string name="route_stops_unavailable">Stop list unavailable</string>
    <string name="route_stops_failed_offline">Couldn\'t load stops — you\'re offline</string>
    <string name="route_stops_failed_rate_limited">Couldn\'t load stops — TfL is rate-limiting</string>
    <string name="route_stops_failed_unreachable">Couldn\'t load stops — can\'t reach TfL</string>
    <string name="route_stops_stale">Stops shown once departures refresh</string>
    <string name="route_stops_retry">Retry</string>
    <!-- The route page's one-time tip on starring a journey (SPEC *Journeys*), and its dismiss action. -->
    <string name="journey_tip">Tap a stop to star the journey there</string>
    <string name="journey_tip_dismiss">Got it</string>
    <!-- Shown when some watched stops refreshed but at least one failed. -->
    <string name="partial_refresh">Some stops couldn\'t be refreshed</string>
    <!-- The same banner naming the nearest stop, and how many more, when known:
         "Oxford Circus: server error", "Oxford Circus +2: network error", or, when the stops
         failed different ways, "Oxford Circus +2 not updated". -->
    <string name="partial_refresh_more">%1$s +%2$d</string>
    <string name="partial_refresh_reason">%1$s: %2$s</string>
    <string name="partial_refresh_no_reason">%1$s not updated</string>
    <string name="partial_reason_offline">offline</string>
    <string name="partial_reason_rate_limited">rate limited</string>
    <string name="partial_reason_network">network error</string>
    <string name="partial_reason_server">server error</string>
    <!-- Shown when arrivals loaded but the disruption lookup failed, so these times'
         disruption status was never checked (SPEC Disruptions: not verified-clean). -->
    <string name="disruptions_unknown">Couldn\'t check for disruptions</string>
    <!-- While a cold load is still bringing stops in: line status is checked once they're all back. -->
    <string name="disruptions_checking">Checking for disruptions</string>
    <!-- Click labels for the stop-closure card, which collapses a long TfL notice to one
         line and expands to the full text on tap. Announced by a screen reader as the action
         ("double tap to Show full alert"); the notice text itself is read from the card. -->
    <string name="alert_expand">Show full alert</string>
    <string name="alert_collapse">Show less</string>
    <!-- The dismiss (×) button on a stop-closure alert: hides the card until the notice changes. -->
    <string name="alert_dismiss">Dismiss alert</string>
    <!-- On a status row (a disrupted line with no predictions), where a countdown would sit. A
         dash when the line's source answered with no trains; a screen reader hears the
         description instead, since a bare dash could read as missing data. -->
    <string name="status_no_departures">–</string>
    <string name="status_no_departures_description">No departures</string>
    <!-- Instead of the dash when no source answered for the line: a National Rail line whose board
         failed, or that no board covers (maintainer, 2026-09-24). -->
    <string name="status_no_data">No data</string>
    <!-- Instead of the dash on a National Rail line when no National Rail key is set, so a key
         would give its times; tapping it opens Settings. -->
    <string name="status_no_rail_key">No key</string>
    <!-- Long-press menu of a near-me row or header: hides every stop and route of that mode from the
         near-me list (SPEC *Finding stops → Hiding a mode*). The argument is the group's name as it
         reads mid-sentence ("bus", "Tube & DLR"); "all … services" says the whole group goes, not
         just this row (maintainer, 2026-09-25). -->
    <string name="hide_mode">Hide all %1$s services</string>
    <!-- Screen-reader label for the long press that opens that menu. -->
    <string name="more_actions">Options</string>
    <!-- One-line banner over the near-me list while modes are hidden; the argument lists them
         ("Bus, Tram"). Its action shows them all again. -->
    <string name="modes_hidden">%1$s hidden</string>
    <string name="modes_show_all">Show all</string>
    <!-- Snackbar when a change of hidden modes couldn't be saved: it holds until the app restarts. -->
    <string name="hidden_modes_write_failed">Couldn\'t save that; it resets when StopDash restarts</string>
    <!-- The near-me list's empty state while modes are hidden, instead of "no departures": the
         hidden modes may be running. The argument lists them ("Bus, Tram"). -->
    <string name="modes_hidden_empty">Nothing else to show with %1$s hidden</string>
    <string name="status_no_rail_key_action">Add a National Rail key</string>
    <!-- A timed row's destination line when TfL gives neither destination nor towards but
         did give a direction; used only when even the direction is missing. -->
    <string name="destination_unknown">Unknown destination</string>
    <!-- Shown over the aged last-good list when a refresh failed outright. -->
    <string name="refresh_failed_offline">Couldn\'t refresh — you\'re offline</string>
    <string name="refresh_failed_rate_limited">Couldn\'t refresh — TfL is rate-limiting</string>
    <string name="refresh_failed_network">Couldn\'t refresh — network error</string>
    <string name="refresh_failed_server">Couldn\'t refresh — server error</string>

    <!-- Honest failure states (SPEC principles 1–2) -->
    <string name="error_offline">You\'re offline</string>
    <string name="error_rate_limited">TfL is rate-limiting requests</string>
    <string name="error_unreachable">Can\'t reach TfL</string>

    <!-- Location gate: the nearby-stops search (SPEC Finding stops). The rationale is
         honest about the location leaving the device, since it does — it's sent to TfL to
         find nearby stops (SPEC Privacy). -->
    <string name="location_title">Departures near you</string>
    <string name="location_rationale">StopDash shows the stops nearest you. Your location is sent to TfL only to find them.</string>
    <string name="location_allow">Allow location</string>
    <string name="location_finding">Finding stops near you…</string>
    <string name="location_no_fix">Couldn\'t get your location</string>
    <string name="location_no_stops">No stops found nearby</string>
    <string name="try_again">Try again</string>
    <!-- Shown after a permanent permission denial, where re-requesting can't prompt again. -->
    <string name="location_denied">Turn on location access in Settings to see nearby stops.</string>
    <string name="open_settings">Open settings</string>

    <!-- Top banner over the departures list when the shown stops are backed by a low-confidence
         location (SPEC *Finding stops*, principle 2), with a "Try again" that re-locates.
         `location_approximate`: the set was resolved from a last-known fallback fix (a fresh fix
         failed — e.g. no GPS on the Underground), so it may be a previous position.
         `location_update_failed`: a refresh couldn't get a fresh fix, so the current set was kept
         rather than jumping to a stale one. Both clear once a fresh fix resolves.
         `location_coarse`: the stops were found from a rough network fix because GPS didn't answer
         in time; it clears when GPS confirms them, or the list moves to where GPS puts you. -->
    <string name="location_approximate">Showing your last-known area</string>
    <string name="location_coarse">Approximate location</string>
    <string name="location_update_failed">Couldn\'t update your location</string>

    <!-- Shown in the widget picker. -->
    <string name="widget_description">Live departures from the stops near you</string>

    <!-- Overflow (three-dot) button in the departures top bar. Neutral because the menu now
         opens more than one destination (Settings and About), so a screen reader shouldn't
         announce it as any single one. -->
    <string name="menu_more">More options</string>

    <!-- Marks the overflow menu with a red dot, appears as a menu item, and labels the button
         shown on the loading screens (departures spinner, location gate), when a newer version is
         available on Google Play; each opens the Play listing. Used as the dot's accessible
         description too. -->
    <string name="update_available">Update available</string>
    <!-- Toast when neither the Play app nor a browser can open the Play listing. -->
    <string name="link_open_failed">No app to open this link</string>
    <string name="update_open_failed">No app to open Google Play</string>

    <!-- Settings screen. -->
    <string name="menu_settings">Settings</string>
    <!-- Overflow item that opens the station search (SPEC *Finding stops*): the "from" end of a
         trip, with "To…" to follow. -->
    <string name="menu_from">From…</string>
    <!-- Location-screen button that opens the station search; spelled out, since "From…" alone
         reads as nothing under a location message. -->
    <string name="menu_find_station">Find a station</string>
    <!-- A searched station's app-bar action: pick a destination, then keep only the departures that
         go there (SPEC *Finding stops → From… To…*). -->
    <string name="menu_to">To…</string>
    <!-- Placeholder in the destination search opened by "To…". -->
    <string name="station_search_to_hint">To station or stop</string>
    <!-- Over a To… list while lines' routes are still loading. -->
    <string name="trip_checking">Checking routes…</string>
    <!-- A To… list with nothing that goes there directly. %1$s is the destination. -->
    <string name="trip_none">No direct trips to %1$s soon</string>
    <!-- Title of a To… from the near-me list: the direct trips from the stops near you. -->
    <string name="trip_title_here">To %1$s</string>
    <!-- A trip with a change (SPEC *Trips with a change*), while TfL's Journey Planner answers. -->
    <string name="trip_planning">Planning…</string>
    <!-- Over a trip's routes while they are planned again; %1$d is how many minutes old they are. -->
    <string name="trip_replanning">Planned %1$d min ago · updating…</string>
    <!-- Over a trip whose planning failed; the reason (offline, rate-limited…) follows. -->
    <string name="trip_plan_failed">Couldn\'t plan the trip: %1$s</string>
    <!-- Some of a station complex's stations couldn't be planned to: the routes shown may miss the best. -->
    <string name="trip_plan_incomplete">Couldn\'t plan to every station</string>
    <!-- A trip the Planner found no route for. -->
    <string name="trip_no_routes">No routes found</string>
    <!-- A route's door-to-door time and arrival, from live trains plus the Planner's run times, so
         "about" (~). %1$d is minutes, %2$s a clock time. -->
    <string name="trip_duration_arrival">%1$d min · ~%2$s</string>
    <!-- The same, with a leg timed from the Planner's timetable because no live train is known yet. -->
    <string name="trip_duration_arrival_estimated">%1$d min · est. %2$s</string>
    <!-- A route whose Planner train is missed with no live train known: no honest arrival to give. -->
    <string name="trip_arrival_unknown">Arrival unknown</string>
    <!-- Between a leg's card and the next: how far it rides. %1$d stops, %2$s where it gets off. -->
    <plurals name="trip_stops_to">
        <item quantity="one">%1$d stop to %2$s</item>
        <item quantity="other">%1$d stops to %2$s</item>
    </plurals>
    <!-- In place of a route's line pills when the whole route is on foot. -->
    <string name="trip_walk_only">Walk</string>
    <!-- A leg either line serves alike, read out for its cut pill: "43 or 134". -->
    <string name="trip_lines_either">%1$s or %2$s</string>
    <!-- One of a cut pill's disrupted lines, read out with the others: "134: Severe Delays". -->
    <string name="trip_line_status">%1$s: %2$s</string>
    <!-- A walk between two stations, in the Planner's minutes. -->
    <!-- A route's first-leg times while its boarding stop's arrivals are still being fetched: one
         word that fits the times slot, no ellipsis (SPEC *Text is chosen to fit its space*). -->
    <string name="trip_times_loading">Loading</string>
    <!-- A route's first leg with no train to show yet: where the rider boards it ("from Muswell Hill Road"). -->
    <string name="trip_first_leg_from">from %1$s</string>
    <string name="trip_walk">%1$d min walk to %2$s</string>
    <!-- Time allowed to change between two rides, shown between their cards. -->
    <!-- A first-leg train for screen readers: its countdown ("3 min") and destination. -->
    <string name="trip_train_description">%1$s to %2$s</string>
    <!-- The same for a train the rider can't use (leaves too soon, or goes another way). -->
    <string name="trip_train_unusable_description">%1$s to %2$s, can\'t catch</string>
    <!-- The same for a train on a named branch whose route to the rider's stop is still being checked. -->
    <string name="trip_train_checking_description">%1$s to %2$s, checking route</string>
    <string name="trip_change">%1$d min to change</string>
    <!-- The rider's walk to the trip's first stop, estimated on the phone. -->
    <string name="trip_walk_first">~%1$d min walk to %2$s</string>
    <!-- A route leg's line isn't running. %1$s is TfL's status ("Suspended"). -->
    <string name="trip_line_not_running">%1$s: %2$s</string>
    <!-- Placeholder in the station search field. -->
    <string name="station_search_hint">Station or stop name</string>
    <!-- Shown under the empty search field. -->
    <string name="station_search_prompt">Type a name to search</string>
    <string name="station_search_no_matches">No matches</string>
    <!-- Headings over the user's own stops, listed before anything is typed. -->
    <string name="station_search_starred">Starred</string>
    <string name="station_search_recent">Recent</string>
    <!-- Under the station matches when TfL's search (which covers bus stops) failed. -->
    <string name="station_search_bus_stops_missing">Bus stops not searched</string>
    <!-- A searched station that has no stops stopdash shows departures for. -->
    <string name="station_no_departures">No departures here</string>
    <string name="settings_title">Settings</string>
    <string name="settings_live_widget_refresh_title">Refresh widget every minute</string>
    <string name="settings_live_widget_refresh_summary">Refreshes the home-screen widget about once a minute in the background. Uses more battery and data.</string>
    <!-- Shown under the toggle when the setting saved but the background refresh couldn't be
