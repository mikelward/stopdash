<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name" translatable="false">StopDash</string>
    <!-- Nothing has come from the phone yet. -->
    <string name="watch_open_phone">Open StopDash on your phone</string>
    <!-- The phone has sent a snapshot with no stops in it. -->
    <string name="watch_add_stops">Add stops on your phone</string>
    <!-- Some of the widget's stops failed to refresh or load. -->
    <string name="watch_partly_out_of_date">Some stops out of date</string>
    <!-- The tile's age stamp: data fetched under a minute ago. -->
    <string name="tile_updated_now">Updated now</string>
    <!-- The tile's age stamp: minutes since the freshest stop was fetched. -->
    <string name="tile_updated_ago">%d min ago</string>
    <!-- Every stop on the tile is past the staleness threshold; countdowns show "?". -->
    <string name="tile_out_of_date">Out of date</string>
    <!-- On the tile: opens the watch app, which lists every stop's departures. -->
    <string name="tile_all_stops">All stops</string>
    <!-- Asks the phone for fresh departures. -->
    <string name="watch_refresh">Refresh</string>
    <!-- A refresh request is waiting for the phone's answer. -->
    <string name="watch_refreshing">Refreshing…</string>
    <!-- The phone couldn't refresh because TfL is rate-limiting it. -->
    <string name="watch_refresh_rate_limited">Couldn\'t refresh: rate-limited</string>
    <!-- The phone couldn't reach TfL to refresh. -->
    <string name="watch_refresh_unreachable">Couldn\'t refresh: TfL unreachable</string>
    <!-- TfL refused the user's API key; it's cleared on the phone, which says so too. -->
    <string name="watch_refresh_key_rejected">Couldn\'t refresh: API key rejected</string>
    <!-- No phone answered the refresh request. -->
    <string name="watch_phone_out_of_reach">Phone out of reach</string>
    <!-- A stop with no departures to show. -->
    <string name="tile_no_departures">No departures</string>
    <!-- A stop with no departures to show whose last refresh failed, so it may have some. -->
    <string name="tile_may_be_out_of_date">May be out of date</string>
    <!-- Every departure there is belongs to a mode hidden on the phone. -->
    <string name="tile_only_hidden">Nothing else to show with modes hidden</string>
    <!-- When no stop has a row: a stop's name, then its empty form ("No departures"). -->
    <string name="tile_stop_empty">%1$s · %2$s</string>
    <!-- The complication's name in the watch face's picker. -->
    <string name="complication_label">Next departure</string>
    <!-- Short complication: the row has no departures left. -->
    <string name="complication_none">None</string>
    <!-- Short complication: the row's stop is out of date, or may be. -->
    <string name="complication_unknown">\?</string>
    <!-- Short complication, a carried-forward stop: "~" marks the countdown (^1) uncertain. -->
    <string name="complication_uncertain_time">~^1</string>
    <!-- A disrupted National Rail line with no times because no National Rail key is set on the phone. -->
    <string name="watch_no_rail_key">No key</string>
    <!-- A disrupted line with no times because its board couldn't be fetched. -->
    <string name="watch_no_data">No data</string>
    <!-- A shown line's service status couldn't be checked, so its countdowns aren't vouched for. -->
    <!-- What a screen reader says for the calendar beside a row's countdown: "Planned Part Closure from 13 Oct". -->
    <string name="planned_alert_description">Planned %1$s from %2$s</string>
    <string name="watch_disruptions_unknown">Couldn\'t check for disruptions</string>
    <!-- A disrupted line's name in the long complication: "Victoria (Severe Delays)". -->
    <string name="complication_line_disrupted">%1$s (%2$s)</string>
    <!-- Long complication: line, destination, then the countdown (^1). -->
    <string name="complication_long_departure">%1$s to %2$s ^1</string>
    <!-- Long complication, a carried-forward stop: the countdown (^1) marked uncertain. -->
    <string name="complication_long_departure_uncertain">%1$s to %2$s ~^1</string>
    <!-- Long complication: the row has no departures left. -->
    <string name="complication_long_none">%1$s: no departures</string>
    <!-- Long complication: no departures left, but the last refresh failed. -->
    <string name="complication_long_unsure">%1$s: may be out of date</string>
    <!-- Long complication: the row's stop is past the staleness threshold. -->
    <string name="complication_long_stale">%1$s: out of date</string>
    <!-- The complication row picker's title. -->
    <string name="complication_pick_title">Show which row?</string>
    <!-- The picker's default: the widget's top row. -->
    <string name="complication_pick_default">Top row</string>
    <!-- Under the default: how the top row is chosen. -->
    <string name="complication_pick_default_detail">Starred first</string>
    <!-- A row in the picker: line code, then destination. -->
    <string name="complication_pick_row">%1$s · %2$s</string>
    <!-- The picker has no rows to offer yet. -->
    <string name="complication_pick_none">No rows to pick yet</string>
    <!-- Heads the trip on the way at the top of the watch app. -->
    <string name="watch_trip">On the way</string>
    <!-- The watch's notification channel for the trip on the way, in the system's settings. -->
    <string name="watch_trip_channel_description">The step you\'re at, while your phone follows a trip</string>
    <!-- Pages back through the trip's steps; spoken by a screen reader. -->
    <string name="watch_trip_previous">Previous step</string>
    <!-- Pages forward through the trip's steps; spoken by a screen reader. -->
    <string name="watch_trip_next">Next step</string>
    <!-- Stops left out because the snapshot was too big to send. -->
    <plurals name="watch_more_stops_on_phone">
        <item quantity="one">%d more stop on phone</item>
        <item quantity="other">%d more stops on phone</item>
    </plurals>
</resources>
